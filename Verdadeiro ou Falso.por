programa {
  funcao inicio() {
    logico aprovado
      
    aprovado = verdadeiro 
    escreva("\nAprovado (verdadeiro): " + aprovado)
    aprovado = falso
    escreva("\nAprovado (falso): " + aprovado)
    aprovado = 1==1
    escreva("\nAprovado (1==1): " + aprovado)
    aprovado = 1==2
    escreva("\nAprovado (1==2): " + aprovado )

  }
}
